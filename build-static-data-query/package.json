{
  "name": "build-static-data-query",
  "version": "1.0.0",
  "description": "GitHub Action for building and processing static data queries",
  "main": "dist/build-static-data-query/index.js",
  "scripts": {
    "full-test": "npm run step-0-test && npm run step-1-test && npm run step-2-test && npm run step-3-test && npm run step-4-test && npm run step-5-test && npm run step-6-test && npm run step-7-test && npm run step-8-test",
    "step-0-test": "tsx src/steps/0-check-schema-version/example.ts",
    "step-1-test": "tsx src/steps/1-download-schema/example.ts",
    "step-2-test": "tsx src/steps/2-generate-scopes/example.ts",
    "step-3-test": "tsx src/steps/3-clean-schema/example.ts",
    "step-4-test": "tsx src/steps/4-generate-fragments/example.ts",
    "step-5-test": "tsx src/steps/5-generate-query/example.ts",
    "step-6-test": "tsx src/steps/6-compile-query/example.ts",
    "step-7-test": "tsx src/steps/7-generate-gql-types/example.ts",
    "step-8-test": "tsx src/steps/8-upload-build/example.ts",
    "build": "tsc && npm run copy-md-files",
    "copy-md-files": "copyfiles -u 1 'src/steps/**/*.md' dist/build-static-data-query/src",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist && rm -rf build && rm -rf _generated",
    "full-test-dist": "npm run step-0-test-dist && npm run step-1-test-dist && npm run step-2-test-dist && npm run step-3-test-dist && npm run step-4-test-dist && npm run step-5-test-dist && npm run step-6-test-dist && npm run step-7-test-dist && npm run step-8-test-dist",
    "step-0-test-dist": "node dist/build-static-data-query/src/steps/0-check-schema-version/example.js",
    "step-1-test-dist": "tsx dist/build-static-data-query/src/steps/1-download-schema/example.js",
    "step-2-test-dist": "tsx dist/build-static-data-query/src/steps/2-generate-scopes/example.js",
    "step-3-test-dist": "tsx dist/build-static-data-query/src/steps/3-clean-schema/example.js",
    "step-4-test-dist": "tsx dist/build-static-data-query/src/steps/4-generate-fragments/example.js",
    "step-5-test-dist": "tsx dist/build-static-data-query/src/steps/5-generate-query/example.js",
    "step-6-test-dist": "tsx dist/build-static-data-query/src/steps/6-compile-query/example.js",
    "step-7-test-dist": "tsx dist/build-static-data-query/src/steps/7-generate-gql-types/example.js",
    "step-8-test-dist": "tsx dist/build-static-data-query/src/steps/8-upload-build/example.js"
  },
  "keywords": [
    "github-action",
    "static-data",
    "query"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/fragment-matcher": "^6.0.0",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript-operations": "^5.0.5",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "copyfiles": "^2.4.1",
    "jest": "^29.5.0",
    "microfiber": "^2.1.1",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.1",
    "@apollo/client": "^4.0.9",
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@google-cloud/storage": "^7.17.1",
    "babel-plugin-graphql-tag": "^3.3.0",
    "graphql": "^16.12.0"
  }
}
