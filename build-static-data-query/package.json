{
  "name": "build-static-data-query",
  "version": "1.0.0",
  "description": "GitHub Action for building and processing static data queries",
  "main": "dist/index.js",
  "scripts": {
    "gql:download": "rimraf ./src/**/*schema.graphql && graphql-codegen -c codegen/codegen.download.ts",
    "gql:generate-scopes": "npx tsx codegen/codegen.generate-scopes.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "github-action",
    "static-data",
    "query"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/fragment-matcher": "^6.0.0",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript-operations": "^5.0.5",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.1",
    "graphql": "^16.12.0"
  }
}
