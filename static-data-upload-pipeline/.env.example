# =============================================================================
# Google Service Account — local development (preferred)
# Download the JSON key file from GCP Console → IAM & Admin → Service Accounts
# → your SA → Keys → Add Key → JSON. Point this var at the downloaded file.
# When set, GOOGLE_CLIENT_EMAIL and GOOGLE_PRIVATE_KEY are ignored locally.
# DO NOT commit the key file to git.
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# Google Service Account — Spreadsheets & GCS Asset Validation
# Used in CI (GitHub Actions secrets) where a key file can't be mounted.
# Obtain: from the same JSON key file — copy client_email and private_key fields.
# =============================================================================
GOOGLE_CLIENT_EMAIL=spreadsheets-sync@mobalytics-1242.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

#=============================================================================
# Google Cloud Storage — Static Data Bucket
# The GCS bucket where final static_data JSON files and schema.json are
# uploaded after a successful pipeline run.
# Obtain: GCP Console → Cloud Storage → bucket name (without gs:// prefix).
# =============================================================================
GCP_BUCKET_NAME=

# =============================================================================
# Google Cloud Storage — Assets Bucket
# The GCS bucket used when validating asset URLs via the GCS strategy
# (preferred over CDN HEAD requests). Defaults to cdn.mobalytics.gg if unset.
# Obtain: GCP Console → Cloud Storage → bucket name (without gs:// prefix).
# =============================================================================
GCP_ASSETS_BUCKET_NAME=cdn.mobalytics.gg

# =============================================================================
# Cloudflare — Cache Purge
# Used to invalidate Cloudflare cache for asset files copied from tmp to prod
# bucket after a successful upload.
# Obtain: Cloudflare Dashboard → My Profile → API Tokens (CF_AUTH_TOKEN),
# and Manage Account → (your zone/client ID) for CF_CLIENT_ID.
# =============================================================================
CF_AUTH_TOKEN=your-cloudflare-api-token
CF_CLIENT_ID=your-cloudflare-client-id

# =============================================================================
# Slack — Bot Token
# Used by SlackMessageManagerV2 to post and update pipeline status messages
# in a Slack channel throughout the pipeline run.
# Obtain: api.slack.com → Your Apps → OAuth & Permissions → Bot User OAuth Token.
# The bot must be invited to the target channel.
# =============================================================================
SLACK_BOT_TOKEN_V2=xoxb-your-slack-bot-token

# =============================================================================
# Slack — Channel ID (optional)
# The channel where pipeline notifications are posted.
# Defaults to C0932450HEF if not set.
# Obtain: Slack → right-click channel → View channel details → Channel ID.
# =============================================================================
SLACK_CHANNEL_ID=C0932450HEF

# =============================================================================
# Report Spreadsheet URL (optional)
# If set, this URL is included in Slack notifications as a link to the
# validation report spreadsheet for quick access.
# Obtain: open the report Google Sheet in browser and copy its URL.
# =============================================================================
REPORT_DOC_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id

# =============================================================================
# GitHub — Automatically provided by GitHub Actions runtime
# These are set automatically in every GitHub Actions workflow run.
# Do NOT set these manually; they are listed here for local testing awareness.
# =============================================================================
# GITHUB_REPOSITORY=mobalytics/your-repo
# GITHUB_RUN_ID=1234567890
