{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Desktop game manifests",
  "description": "Array of IManifest objects consumed by moba-desktop-ow-electron. Cross-field rules (mainWindow must be a windows key, unique game/gameIds) are enforced by validate-manifest.mjs, not by this schema.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["gameIds", "game", "version", "minDesktopVersion", "mainWindow", "windows", "hotkeys"],
    "properties": {
      "gameIds": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "integer" }
      },
      "game": { "type": "string", "minLength": 1 },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
      },
      "minDesktopVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
      },
      "mainWindow": { "type": "string", "minLength": 1 },
      "windows": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": "object" }
      },
      "hotkeys": { "type": "object" },
      "features": { "type": "object" },
      "defaultSettings": { "type": "object" }
    },
    "additionalProperties": true
  }
}
